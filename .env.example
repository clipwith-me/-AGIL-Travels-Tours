# AGIL Travels — environment variables
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit real keys.

# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key (server-only, full access). Used by the API route handlers
# to write enquiries. NEVER expose this to the browser / never prefix NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
