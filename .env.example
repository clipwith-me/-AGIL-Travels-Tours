# AGIL Travels — environment variables
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit real keys.

# Public site URL — used for SEO metadata, sitemap, and OG tags.
# In production set this to the real domain (e.g. https://agiltravels.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key (server-only, full access). Used by the API route handlers
# to write enquiries. NEVER expose this to the browser / never prefix NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable (anon) key — safe in the browser. Used for direct-to-Storage
# document uploads (visa application form) via signed URLs.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bootstrap admin for the staff dashboard: whoever signs in with this email
# becomes an admin automatically. Set the account + password in Supabase Auth.
ADMIN_EMAIL=

# Email via Resend (optional). Until both are set, emails are logged not sent.
RESEND_API_KEY=
EMAIL_FROM="AGIL Travels <noreply@yourdomain.com>"

# --- Payments ---------------------------------------------------------------
# Stripe — dashboard.stripe.com → Developers → API keys. TEST keys are instant
# (start with sk_test_). STRIPE_WEBHOOK_SECRET (whsec_...) comes from the
# webhook you register at /api/payments/stripe/webhook (or `stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ziina — business dashboard API key. Ziina processes in AED only.
# ZIINA_API_BASE defaults to https://api-v2.ziina.com/api (verify vs their docs).
# ZIINA_TEST defaults to true; set to "false" for live charges.
ZIINA_API_KEY=
# ZIINA_API_BASE=https://api-v2.ziina.com/api
# ZIINA_TEST=true

# Tabby (Pay in 4, UAE BNPL). Sandbox keys until Tabby approves production.
# Public key is browser-safe; secret key is server-only.
NEXT_PUBLIC_TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
# TABBY_CURRENCY=AED
