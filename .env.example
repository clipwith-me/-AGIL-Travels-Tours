# AGIL Travels — environment variables
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit real keys.

# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key (server-only, full access). Used by the API route handlers
# to write enquiries. NEVER expose this to the browser / never prefix NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---------------------------------------------------------------
# Stripe — dashboard.stripe.com → Developers → API keys. TEST keys are instant
# (start with sk_test_). STRIPE_WEBHOOK_SECRET (whsec_...) comes from the
# webhook you register at /api/payments/stripe/webhook (or `stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ziina — business dashboard API key. Ziina processes in AED only.
# ZIINA_API_BASE defaults to https://api-v2.ziina.com/api (verify vs their docs).
# ZIINA_TEST defaults to true; set to "false" for live charges.
ZIINA_API_KEY=
# ZIINA_API_BASE=https://api-v2.ziina.com/api
# ZIINA_TEST=true
